{
  "sourceLanguage": "en",
  "strings": {
    "%@ failed: %@": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sikertelen: %2$@"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzáadás"
          }
        }
      }
    },
    "Add Folder…": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappa hozzáadása…"
          }
        }
      }
    },
    "Add a folder": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappa hozzáadása"
          }
        }
      }
    },
    "Add a folder or a network share, give it a name and an icon, and it appears in the Finder sidebar.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy mappát vagy hálózati megosztást, adj neki nevet és ikont, és megjelenik a Finder oldalsávjában."
          }
        }
      }
    },
    "Add a place first; each one then appears here.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előbb adj hozzá egy helyet; mindegyik itt jelenik meg."
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezés…"
          }
        }
      }
    },
    "Blue": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kék"
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újraellenőrzés"
          }
        }
      }
    },
    "Choose": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválasztás"
          }
        }
      }
    },
    "Choose a folder or a mounted network share for the Finder sidebar.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassz egy mappát vagy csatlakoztatott hálózati megosztást a Finder oldalsávjába."
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválasztás…"
          }
        }
      }
    },
    "Click Enable at the top of the Finder window that opens.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattints az Engedélyezés gombra a megnyíló Finder-ablak tetején."
          }
        }
      }
    },
    "Clicking a place jumps straight to the real folder": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintásra egyenesen a valódi mappára ugrik"
          }
        }
      }
    },
    "Color": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szín"
          }
        }
      }
    },
    "Edit Places…": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyek szerkesztése…"
          }
        }
      }
    },
    "Enable in Finder": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezés a Finderben"
          }
        }
      }
    },
    "Finder shows new names and icons after it starts again.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az új neveket és ikonokat a Finder újraindítás után mutatja."
          }
        }
      }
    },
    "Finish Setup (%lld)…": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beállítás befejezése (%lld)…"
          }
        }
      }
    },
