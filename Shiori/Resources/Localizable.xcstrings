      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappa"
          }
        }
      }
    },
    "Folders & Drives": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappák és meghajtók"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Általános"
          }
        }
      }
    },
    "Graphite": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafit"
          }
        }
